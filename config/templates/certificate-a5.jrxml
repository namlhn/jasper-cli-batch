<jasperReport name="certificate_a5" pageWidth="595" pageHeight="420" orientation="Landscape"
              columnWidth="595" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0">
    <style name="Default" default="true" fontName="Noto Sans"/>
    <parameter name="CERTIFICATE_NO" class="java.lang.String"/>
    <parameter name="FULL_NAME" class="java.lang.String"/>
    <parameter name="DOB" class="java.lang.String"/>
    <parameter name="ORGANIZATION" class="java.lang.String"/>
    <parameter name="PHOTO" class="java.awt.image.BufferedImage"/>
    <parameter name="QR_IMAGE" class="java.awt.image.BufferedImage"/>

    <background height="420">
        <element kind="rectangle" x="8" y="8" width="579" height="404">
            <pen lineWidth="2.0"/>
        </element>
        <element kind="staticText" x="0" y="30" width="595" height="30"
                 hTextAlign="Center" fontName="Noto Sans" fontSize="18" bold="true">
            <text><![CDATA[GIẤY CHỨNG NHẬN]]></text>
        </element>
    </background>

    <detail>
        <band height="420">
            <element kind="image" x="45" y="100" width="90" height="120"
                     scaleImage="RetainShape" onErrorType="Blank">
                <expression><![CDATA[$P{PHOTO}]]></expression>
            </element>
            <element kind="staticText" x="160" y="85" width="110" height="20">
                <text><![CDATA[Số chứng nhận:]]></text>
            </element>
            <element kind="textField" x="270" y="85" width="230" height="20">
                <expression><![CDATA[$P{CERTIFICATE_NO}]]></expression>
            </element>
            <element kind="staticText" x="160" y="125" width="110" height="20">
                <text><![CDATA[Họ và tên:]]></text>
            </element>
            <element kind="textField" x="270" y="120" width="260" height="28"
                     fontName="Noto Sans" fontSize="13" bold="true">
                <expression><![CDATA[$P{FULL_NAME}]]></expression>
            </element>
            <element kind="staticText" x="160" y="165" width="110" height="20">
                <text><![CDATA[Ngày sinh:]]></text>
            </element>
            <element kind="textField" x="270" y="165" width="230" height="20">
                <expression><![CDATA[$P{DOB}]]></expression>
            </element>
            <element kind="staticText" x="160" y="205" width="110" height="20">
                <text><![CDATA[Đơn vị:]]></text>
            </element>
            <element kind="textField" x="270" y="200" width="260" height="40" textAdjust="ScaleFont">
                <expression><![CDATA[$P{ORGANIZATION}]]></expression>
            </element>
            <element kind="image" x="470" y="285" width="80" height="80" scaleImage="RetainShape">
                <expression><![CDATA[$P{QR_IMAGE}]]></expression>
            </element>
            <element kind="staticText" x="160" y="280" width="240" height="55"
                     hTextAlign="Center" fontName="Noto Sans" fontSize="11" bold="true">
                <text><![CDATA[ĐẠI DIỆN ĐƠN VỊ CẤP CHỨNG NHẬN]]></text>
            </element>
        </band>
    </detail>
</jasperReport>
